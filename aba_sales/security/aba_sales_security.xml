<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Two ABA groups. Andrea Basile gets both in post_init_hook. -->
    <record id="group_catalog_manager" model="res.groups">
        <field name="name">ABA / Gestore catalogo</field>
        <field name="comment">Può creare, modificare ed eliminare prodotti, categorie, attributi e relativi documenti (contratti).</field>
        <field name="implied_ids" eval="[(4, ref('product.group_product_manager'))]"/>
    </record>

    <record id="group_discount_approver" model="res.groups">
        <field name="name">ABA / Approvatore sconti</field>
        <field name="comment">Può approvare o rifiutare le richieste di sconto oltre il limite.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- ===== Discount requests ===== -->
    <record id="rule_request_salesman_own" model="ir.rule">
        <field name="name">Richieste sconto: il commerciale vede le proprie</field>
        <field name="model_id" ref="model_aba_discount_request"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="rule_request_approver_all" model="ir.rule">
        <field name="name">Richieste sconto: l'approvatore e i responsabili vedono tutte</field>
        <field name="model_id" ref="model_aba_discount_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_discount_approver')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- ===== Catalog: only the catalog manager can change it =====
         Global rules (no group) are ANDed with the standard access rights: reading stays
         open, create / write / delete need the catalog manager group. -->
    <record id="rule_product_template_catalog_only" model="ir.rule">
        <field name="name">Catalogo ABA: prodotti modificabili solo dal gestore</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('aba_sales.group_catalog_manager') else [(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_product_product_catalog_only" model="ir.rule">
        <field name="name">Catalogo ABA: varianti modificabili solo dal gestore</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('aba_sales.group_catalog_manager') else [(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_product_category_catalog_only" model="ir.rule">
        <field name="name">Catalogo ABA: categorie modificabili solo dal gestore</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('aba_sales.group_catalog_manager') else [(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_product_attribute_catalog_only" model="ir.rule">
        <field name="name">Catalogo ABA: attributi modificabili solo dal gestore</field>
        <field name="model_id" ref="product.model_product_attribute"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('aba_sales.group_catalog_manager') else [(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Contracts are uploaded on the product as documents: same restriction. -->
    <record id="rule_product_document_catalog_only" model="ir.rule">
        <field name="name">Catalogo ABA: contratti e documenti prodotto modificabili solo dal gestore</field>
        <field name="model_id" ref="product.model_product_document"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('aba_sales.group_catalog_manager') else [(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
